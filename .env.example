# ============================================================
#  Django (local + Railway backend service)
# ============================================================

DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string
DEBUG=True

# Local: run `railway link` + `railway run env` or paste from Railway Postgres service variables.
# Production: Railway injects DATABASE_URL when you connect Postgres to the Django service.
DATABASE_URL=postgresql://postgres:password@localhost:5432/railway

ALLOWED_HOSTS=localhost,127.0.0.1,.railway.app
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
FRONTEND_URL=http://localhost:3000

# ============================================================
#  Next.js (local + Railway frontend service, root: frontend/)
# ============================================================

DJANGO_API_URL=http://127.0.0.1:8000
