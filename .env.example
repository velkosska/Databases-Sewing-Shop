# ============================================================
#  Django service environment variables (set in Railway dashboard)
# ============================================================

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string

# Set to False in production
DEBUG=False

# Comma-separated; add your Railway Django subdomain
ALLOWED_HOSTS=your-django-service.up.railway.app

# From Supabase → Project Settings → Database → Connection string (URI mode)
DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# Comma-separated list of allowed frontend origins (your Next.js Railway URL)
CORS_ALLOWED_ORIGINS=https://your-frontend.up.railway.app


# ============================================================
#  Next.js service environment variables (set in Railway dashboard)
# ============================================================

# Internal URL of your Django Railway service (used for server-side API calls)
DJANGO_INTERNAL_URL=https://your-django-service.up.railway.app
