# ============================================================
#  Django (local + Railway backend service)
# ============================================================

DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string
DEBUG=True

# Production: Railway injects DATABASE_URL when Postgres is linked to the Django service.
# Optional: reference PGHOST, PGUSER, PGPASSWORD, PGDATABASE from Postgres instead.
DATABASE_URL=postgresql://postgres:password@localhost:5432/railway

ALLOWED_HOSTS=localhost,127.0.0.1,.railway.app
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
FRONTEND_URL=http://localhost:3000

# ============================================================
#  Next.js (local + Railway frontend service, root: frontend/)
# ============================================================

DJANGO_API_URL=http://127.0.0.1:8000

# Exposed to the browser — must be the public Railway URL (no trailing slash).
# Set this on the costuras-de-paqui Railway service.
# Example: https://databases-sewing-shop-production.up.railway.app
NEXT_PUBLIC_DJANGO_URL=http://127.0.0.1:8000
